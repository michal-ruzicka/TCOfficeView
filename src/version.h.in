#ifndef TCOV_VERSION_H
#define TCOV_VERSION_H

/*
 * Generated by CMake from version= in src/pluginst.inf, the single source of truth for the plugin
 * version. Edit pluginst.inf, never the generated build/<arch>/version.h.
 */
#define TCOV_VER_MAJOR      @TCOV_VER_MAJOR@
#define TCOV_VER_MINOR      @TCOV_VER_MINOR@
#define TCOV_VER_PATCH      @TCOV_VER_PATCH@

#define TCOV_VERSION_CSV    @TCOV_VER_MAJOR@,@TCOV_VER_MINOR@,@TCOV_VER_PATCH@,0
#define TCOV_VERSION_STR    "@TCOV_VER_MAJOR@.@TCOV_VER_MINOR@.@TCOV_VER_PATCH@.0"
#define TCOV_PRODUCT_VER    "@TCOV_VERSION@"  /* as in pluginst.inf, e.g. "2.4.1-devel" */

/* TCOfficeView.wlx (32-bit) or TCOfficeView.wlx64 (64-bit): the name Total Commander requires per bitness */
#define TCOV_FILE_NAME      "@TCOV_FILE_NAME@"

/* TCOfficeViewHost.exe (64-bit) or TCOfficeViewHost_x86.exe (32-bit): the name build.cmd stages the host under */
#define TCOV_HOST_FILE_NAME "@TCOV_HOST_FILE_NAME@"

#endif /* TCOV_VERSION_H */
